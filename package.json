{
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "1.139.0",
    "@playwright/test": "^1.63.0",
    "@tabler/icons": "^3.48.0",
    "fuse.js": "^7.5.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "icons": "node scripts/update-icons.mjs",
    "icons:generate": "node import-icons.js",
    "test:figma": "node scripts/figma-tests.mjs",
    "test:unit": "vitest run",
    "test:ui": "playwright test"
  },
  "figma-plugin": {
    "editorType": [
      "figma",
      "figjam"
    ],
    "id": "1169807996149376642",
    "name": "Tabler Icons",
    "main": "src/main.ts",
    "ui": "src/ui.tsx",
    "documentAccess": "dynamic-page",
    "networkAccess": {
      "allowedDomains": [
        "none"
      ],
      "reasoning": "This plugin does not require network access."
    }
  }
}
