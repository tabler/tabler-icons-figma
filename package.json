{
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "1.139.0",
    "@tabler/icons": "^3.48.0",
    "fuse.js": "^7.5.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch",
    "icons": "pnpm up --latest @tabler/icons && pnpm run icons:generate && pnpm run build && git add package.json pnpm-lock.yaml src/icons.json && git commit -m \"update icons to v`node -p \\\"require('./node_modules/@tabler/icons/package.json').version\\\"`\" && git push",
    "icons:generate": "node import-icons.js"
  },
  "figma-plugin": {
    "editorType": [
      "figma",
      "figjam"
    ],
    "id": "1169807996149376642",
    "name": "Tabler Icons",
    "main": "src/main.ts",
    "ui": "src/ui.tsx",
    "networkAccess": {
      "allowedDomains": [
        "none"
      ],
      "reasoning": "This plugin does not require network access."
    }
  }
}
